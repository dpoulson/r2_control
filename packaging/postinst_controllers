#!/bin/bash
set -e

# 1. Reload systemd to recognize the new service file
systemctl daemon-reload

# 2. Enable and start your services
systemctl enable r2_joy.service || true
systemctl restart r2_joy.service || true
systemctl enable r2_ble.service || true
systemctl restart r2_ble.service || true

# 3. Configure Apache
a2ensite 000-r2.conf || true

# 4. Restart Apache to apply changes
systemctl restart apache2 || true

exit 0
